[
  {
    "name": "theme_info",
    "theme_name": "Wild Sea Expeditions",
    "theme_version": "0.1.0",
    "theme_author": "Shopify",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.branding",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "t:labels.logo"
      },
      {
        "type": "image_picker",
        "id": "logo_inverse",
        "label": "t:labels.logo_inverse"
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "t:labels.logo_width",
        "min": 60,
        "max": 300,
        "step": 10,
        "unit": "px",
        "default": 140
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "t:labels.favicon"
      },
      {
        "type": "image_picker",
        "id": "social_image",
        "label": "t:labels.social_image"
      }
    ]
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "label": "t:labels.body_font",
        "default": "dm_sans_n4"
      },
      {
        "type": "font_picker",
        "id": "heading_font",
        "label": "t:labels.heading_font",
        "default": "barlow_condensed_n6"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color_scheme_group",
        "id": "color_schemes",
        "definition": [
          {
            "type": "color",
            "id": "background",
            "label": "t:labels.background",
            "default": "#F6F5F0"
          },
          {
            "type": "color_background",
            "id": "background_gradient",
            "label": "t:labels.background_gradient"
          },
          {
            "type": "color",
            "id": "text",
            "label": "t:labels.text",
            "default": "#102C2D"
          },
          {
            "type": "color",
            "id": "button",
            "label": "t:labels.button",
            "default": "#102C2D"
          },
          {
            "type": "color",
            "id": "button_label",
            "label": "t:labels.button_label",
            "default": "#F6F5F0"
          },
          {
            "type": "color",
            "id": "border",
            "label": "t:labels.border",
            "default": "#D6DAD2"
          }
        ],
        "role": {
          "background": {
            "solid": "background",
            "gradient": "background_gradient"
          },
          "text": "text",
          "links": "text",
          "icons": "text",
          "primary_button": "button",
          "on_primary_button": "button_label",
          "primary_button_border": "button",
          "secondary_button": "background",
          "on_secondary_button": "text",
          "secondary_button_border": "text"
        }
      },
      {
        "type": "color_scheme",
        "id": "default_color_scheme",
        "label": "t:labels.default_color_scheme",
        "default": "scheme-1"
      }
    ]
  },
  {
    "name": "t:general.controls",
    "settings": [
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 4
      }
    ]
  },
  {
    "name": "t:general.social_links",
    "settings": [
      {
        "type": "url",
        "id": "social_instagram_link",
        "label": "Instagram"
      },
      {
        "type": "url",
        "id": "social_youtube_link",
        "label": "YouTube"
      },
      {
        "type": "url",
        "id": "social_facebook_link",
        "label": "Facebook"
      }
    ]
  }
]
