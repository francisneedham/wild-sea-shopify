{% doc %}
  Server-rendered Lucide icon; visible before storefront JavaScript loads.
  Paths match installed lucide package.

  Brand icons (instagram, youtube, facebook) use the last Lucide paths before brand icons were dropped.

  @param {string} name - Icon name: arrow-right, arrow-up-right, chevron-down, chevron-right, compass, facebook, fish, instagram, map-pin, menu, minus, play, plus, arrow-left, calendar-days, sun, arrow-down, waves-horizontal, wind, check, download, maximize-2, search, shield-check, shopping-bag, sliders-horizontal, user-round, users-round, x, or youtube.
  @example
  {% render 'lucide-icon', name: 'search' %}
{% enddoc %}

<svg xmlns="http://www.w3.org/2000/svg" {% unless name == 'instagram' or name == 'youtube' or name == 'facebook' %}data-lucide="{{ name }}"{% endunless %} width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {% case name %}
    {% when 'arrow-right' %}
      <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
    {% when 'chevron-down' %}
      <path d="m6 9 6 6 6-6"/>
    {% when 'chevron-right' %}
      <path d="m9 18 6-6-6-6"/>
    {% when 'menu' %}
      <path d="M4 5h16"/><path d="M4 12h16"/><path d="M4 19h16"/>
    {% when 'search' %}
      <path d="m21 21-4.34-4.34"/><circle cx="11" cy="11" r="8"/>
    {% when 'shopping-bag' %}
      <path d="M16 10a4 4 0 0 1-8 0"/><path d="M3.103 6.034h17.794"/><path d="M3.4 5.467a2 2 0 0 0-.4 1.2V20a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6.667a2 2 0 0 0-.4-1.2l-2-2.667A2 2 0 0 0 17 2H7a2 2 0 0 0-1.6.8z"/>
    {% when 'sliders-horizontal' %}
      <path d="M10 5H3"/><path d="M12 19H3"/><path d="M14 3v4"/><path d="M16 17v4"/><path d="M21 12h-9"/><path d="M21 19h-5"/><path d="M21 5h-7"/><path d="M8 10v4"/><path d="M8 12H3"/>
    {% when 'user-round' %}
      <circle cx="12" cy="8" r="5"/><path d="M20 21a8 8 0 0 0-16 0"/>
    {% when 'x' %}
      <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
    {% when 'calendar-days' %}
      <path d="M8 2v3"/><path d="M16 2v3"/><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/><path d="M8 13h.01"/><path d="M12 13h.01"/><path d="M16 13h.01"/><path d="M8 17h.01"/><path d="M12 17h.01"/><path d="M16 17h.01"/>
    {% when 'sun' %}
      <circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/>
    {% when 'arrow-down' %}
      <path d="M12 5v14"/><path d="m19 12-7 7-7-7"/>
    {% when 'waves-horizontal' %}
      <path d="M2 12q2.5 2 5 0t5 0 5 0 5 0"/><path d="M2 19q2.5 2 5 0t5 0 5 0 5 0"/><path d="M2 5q2.5 2 5 0t5 0 5 0 5 0"/>
    {% when 'wind' %}
