{% doc %}
  Shared destination listing and detail styles (detail mirrors the legacy Socotra page).
  @example
  {% render 'destination-styles' %}
{% enddoc %}

{% stylesheet %}
  .destination-wrap { width: min(100%, var(--page-width)); padding-inline: var(--site-gutter); margin-inline: auto; }
  .destination-lead { max-width: 62ch; font-size: 14px; line-height: 1.7; }
  .destination-listing__intro { padding: clamp(64px, 9vw, 130px) 0 45px; }
  .destination-listing__intro h1 { margin: 0 0 20px; font-size: clamp(65px, 10vw, 140px); line-height: .9; }
  .destination-listing__toolbar { display: flex; justify-content: space-between; gap: 20px; flex-wrap: wrap; padding: 22px 0; border-block: 1px solid var(--theme-border); font-size: var(--text-label); text-transform: uppercase; letter-spacing: .08em; }
  .destination-filters { display: flex; flex-wrap: wrap; gap: 8px; }
  .destination-filters button { padding: 10px 16px; border: 1px solid var(--theme-border); }
  .destination-filters button[aria-pressed='true'] { color: var(--theme-button-text); background: var(--theme-button); border-color: var(--theme-button); }
  .destination-listing__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 30px; padding: 34px 0 90px; }
  .destination-card { min-width: 0; display: block; color: inherit; text-decoration: none; }
  .destination-card[hidden] { display: none; }
  .destination-card__image { position: relative; aspect-ratio: 3 / 2; overflow: hidden; background: var(--theme-border); }
  .destination-card__image img { width: 100%; height: 100%; object-fit: cover; transition: transform .35s ease; }
  .destination-card:hover img { transform: scale(1.04); }
  .destination-card__body { padding-top: 22px; }
  .destination-status--closed { opacity: .75; }
  .destination-status--last { background: #dfc89e; color: #102c2d; border-color: #dfc89e; }
  .destination-card__body h2 { margin: 8px 0 12px; font-size: clamp(32px, 4vw, 52px); line-height: 1; }
  .destination-card__body p { font-size: var(--text-sm); line-height: 1.7; }
  .destination-card__facts { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 18px; font-size: var(--text-label); letter-spacing: .05em; text-transform: uppercase; }
  .destination-card__facts span { padding: 7px 10px; border: 1px solid var(--theme-border); }
  @media (max-width: 900px) { .destination-listing__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 650px) { .destination-listing__grid { grid-template-columns: 1fr; } }

  /* ---- Destination detail: legacy socotra.js / style.css, 1:1 with the type floor applied. ---- */
  .destination-page figure { margin: 0; }
  .destination-section { padding-block: 100px; }
  .destination-section--flush-top { padding-top: 0; }
  .destination-bg--sage { background: #eaede3; }
  .destination-bg--stone { background: #eeeee5; }
  .destination-bg--ink { background: #102c2d; color: #fff; }
  .destination-eyebrow { display: flex; align-items: center; gap: 12px; margin: 0 0 22px; font-size: var(--text-label); font-weight: 600; letter-spacing: .23em; text-transform: uppercase; }
  .destination-eyebrow::before { content: ''; flex-shrink: 0; width: 28px; height: 1px; background: currentColor; }
  .destination-h2 { margin: 0 0 25px; font-size: clamp(44px, 5.2vw, 76px); line-height: .98; letter-spacing: -.02em; text-transform: uppercase; }
  .destination-top { display: flex; justify-content: space-between; align-items: end; gap: 35px; margin-bottom: 38px; }
  .destination-top .destination-h2 { margin: 0; }
  .destination-top__intro { max-width: 340px; margin: 0; font-size: var(--text-sm); line-height: 1.7; color: color-mix(in srgb, currentColor 72%, transparent); }
  .destination-kicker { display: block; margin-bottom: 12px; font-size: var(--text-label); line-height: 1.5; letter-spacing: .15em; text-transform: uppercase; color: color-mix(in srgb, currentColor 62%, transparent); }
  .destination-body { font-size: var(--text-sm); line-height: 1.8; color: color-mix(in srgb, currentColor 75%, transparent); }
  .destination-body p { margin: 0 0 1em; }
  .destination-body ul { padding-left: 1.2em; list-style: disc; }
  .destination-note { display: flex; gap: 12px; align-items: start; margin: 25px 0 0; font-size: var(--text-sm); line-height: 1.8; color: color-mix(in srgb, currentColor 68%, transparent); }
  .destination-note svg { flex-shrink: 0; width: 17px; height: 17px; margin-top: 4px; }
  .destination-note--subtle { font-size: var(--text-label); }

  .destination-btn { display: inline-flex; justify-content: center; align-items: center; gap: 30px; padding: 19px 26px; border: 1px solid transparent; background: #dfc89e; color: #102c2d; font-size: var(--text-label); font-weight: 700; letter-spacing: .1em; text-transform: uppercase; text-decoration: none; transition: background .2s, transform .2s; }
  .destination-btn:hover { background: #ecd9b7; transform: translateY(-2px); }
  .destination-btn svg { flex-shrink: 0; width: 16px; height: 16px; }
  .destination-btn--dark { background: #102c2d; color: #fff; }
  .destination-btn--dark:hover { background: #245254; }
  .destination-btn--outline { background: transparent; border-color: #ffffff60; color: #fff; }
  .destination-btn--outline:hover { background: #ffffff15; }
  .destination-btn--text { gap: 26px; padding: 12px 0; border: 0; border-bottom: 1px solid currentColor; background: none; color: inherit; white-space: nowrap; }
  .destination-btn--text:hover { background: none; }

  /* Hero */
  .destination-hero { position: relative; display: flex; align-items: end; height: 740px; overflow: hidden; color: #fff; background: #102c2d; }
  .destination-hero__image { position: absolute; inset: 0; }
  .destination-hero__image img { width: 100%; height: 100%; object-fit: cover; object-position: center 42%; }
  .destination-hero::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, #071e1db3 0%, #071e1d25 72%), linear-gradient(0deg, #071e1dac, transparent 75%); pointer-events: none; }
  .destination-hero__content { position: relative; z-index: 2; width: 100%; padding-bottom: 50px; }
  .destination-breadcrumb { display: flex; align-items: center; gap: 12px; margin-bottom: 24px; font-size: var(--text-label); letter-spacing: .08em; text-transform: uppercase; }
  .destination-breadcrumb a { color: inherit; text-decoration: none; }
  .destination-breadcrumb svg { width: 12px; height: 12px; }
  .destination-hero h1 { margin: 0 0 24px; font-size: clamp(86px, 8.2vw, 126px); line-height: .92; letter-spacing: -.02em; text-transform: uppercase; }
  .destination-hero h1 span:not(.reveal-break) { color: #dfc89e; }
  .destination-hero__intro { max-width: 460px; margin: 0; font-size: var(--text-sm); line-height: 1.8; color: #ffffffdc; }
  .destination-hero__actions { display: flex; align-items: center; flex-wrap: wrap; gap: 30px; margin-top: 25px; }
  .destination-hero__link { display: flex; align-items: center; gap: 12px; color: inherit; font-size: var(--text-label); letter-spacing: .05em; text-decoration: none; }
  .destination-hero__link svg { width: 17px; height: 17px; }
  .destination-recap { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin: 0; padding-block: 35px; border-bottom: 1px solid #d6dad2; }
  .destination-recap > div { display: flex; align-items: center; gap: 18px; }
  .destination-recap svg { flex-shrink: 0; width: 25px; height: 25px; color: #889385; }
  .destination-recap dt { margin-bottom: 7px; font-size: var(--text-label); letter-spacing: .12em; text-transform: uppercase; color: #66756b; }
  .destination-recap dd { margin: 0; font-size: var(--text-sm); font-weight: 500; }
  .destination-status { display: inline-block; margin-bottom: 18px; padding: 7px 10px; border: 1px solid currentColor; font-size: var(--text-label); font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }

  /* Anchor nav: high-contrast sticky bar with scroll-driven active link. */
  /* Sticky on the section wrapper: a sticky element only sticks inside its parent, which here is just the nav. */
  .shopify-section:has(> .destination-nav) { position: sticky; top: calc(var(--header-height) - 1px); z-index: 30; }
  .destination-nav { border-top: 1px solid #ffffff40; border-bottom: 1px solid #ffffff25; background: #080d0d; color: #d3d9d2; }
  .destination-nav__inner { display: flex; align-items: center; gap: 30px; max-width: var(--page-width); margin: auto; padding: 22px var(--site-gutter); overflow-x: auto; white-space: nowrap; scrollbar-width: none; font-size: var(--text-label); letter-spacing: .04em; }
  .destination-nav a { position: relative; padding-block: 4px; color: inherit; text-decoration: none; transition: color .2s; }
  .destination-nav a:hover { color: #fff; }
  .destination-nav a.is-active { color: #dfc89e; }
  .destination-nav a.is-active::after { content: ''; position: absolute; left: 0; right: 0; bottom: -7px; height: 2px; background: #dfc89e; }
  html:has(.destination-nav) { scroll-padding-top: calc(var(--header-height) + 80px); }

  /* Editorial */
  .destination-editorial { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center; }
  .destination-editorial--reverse .destination-editorial__photo { order: -1; }
  .destination-editorial__photo img { display: block; width: 100%; height: 540px; object-fit: cover; }
  .destination-caption { display: block; margin-top: 14px; font-size: var(--text-label); letter-spacing: .13em; text-transform: uppercase; }
  .destination-points { display: grid; gap: 12px; margin-block: 24px 28px; font-size: var(--text-sm); }
  .destination-points span { display: flex; align-items: center; gap: 12px; }
  .destination-points svg { flex-shrink: 0; width: 18px; height: 18px; color: #83907c; }
  .destination-specs-list { margin: 26px 0 0; border-top: 1px solid #d6dad2; }
  .destination-specs-list > div { display: flex; justify-content: space-between; gap: 20px; padding: 14px 0; border-bottom: 1px solid #d6dad2; font-size: var(--text-sm); }
  .destination-specs-list dt { color: #77866e; }
  .destination-specs-list dd { margin: 0; text-align: right; }
  .destination-editorial__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 24px; margin-top: 28px; }

  /* Cards: techniques / seasons / options / equipment / inclusions */
  .destination-cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 25px; }
  .destination-cards--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .destination-card-h3 { margin: 0 0 20px; line-height: .98; text-transform: uppercase; }
  .destination-technique { padding-top: 26px; border-top: 1px solid #aebbac; }
  .destination-technique__number { display: block; margin-bottom: 27px; font-family: var(--font-heading-family); font-size: 46px; font-weight: 600; line-height: 1; color: #a4b29b; }
  .destination-technique .destination-card-h3 { margin-bottom: 17px; font-size: 39px; }
  .destination-technique .destination-body { margin-top: 19px; }
  .destination-cards--techniques { gap: 40px; }
  .destination-strip { display: flex; align-items: center; gap: 30px; margin-top: 25px; padding-top: 26px; border-top: 1px solid #c6cfbf; }
  .destination-strip > span { font-size: var(--text-label); letter-spacing: .09em; text-transform: uppercase; white-space: nowrap; }
  .destination-strip p { margin: 0; font-size: var(--text-sm); color: #63745e; }
  .destination-season { padding: 35px; border: 1px solid #d6dad2; }
  .destination-season .destination-card-h3 { font-size: 43px; }
  .destination-option { padding: 40px; background: #f6f5f0; }
  .destination-option .destination-kicker { margin-bottom: 24px; }
  .destination-option .destination-card-h3 { margin-bottom: 25px; font-size: 49px; }
  .destination-option--dark { background: #102c2d; color: #fff; }
  .destination-option--dark .destination-kicker, .destination-option--dark .destination-body { color: #bac7b8; }
  .destination-option .destination-btn { width: 100%; justify-content: space-between; }
  .destination-option-specs { display: grid; grid-template-columns: 1fr 1fr; gap: 23px 15px; margin: 28px 0 32px; padding-top: 27px; border-top: 1px solid #a3b09955; }
  .destination-option-specs dt { margin-bottom: 7px; font-size: var(--text-label); letter-spacing: .12em; text-transform: uppercase; color: #82917b; }
  .destination-option--dark .destination-option-specs dt { color: #adbfa6; }
  .destination-option-specs dd { margin: 0; font-size: var(--text-sm); }
  .destination-equipment { padding: 30px; border: 1px solid #d6dad2; }
  .destination-equipment .destination-eyebrow { letter-spacing: .15em; }
  .destination-equipment .destination-card-h3 { margin-bottom: 28px; font-size: 36px; }
  .destination-equipment dl { margin: 0; }
  .destination-equipment dl > div { padding-block: 16px; border-top: 1px solid #d6dad2; }
  .destination-equipment dt { margin-bottom: 8px; font-size: var(--text-label); letter-spacing: .07em; text-transform: uppercase; color: #76866e; }
  .destination-equipment dd { margin: 0; font-size: var(--text-sm); line-height: 1.7; }
  .destination-inclusion { padding: 35px; background: #f6f5f0; }
  .destination-inclusion .destination-card-h3 { margin-bottom: 30px; font-size: 39px; }
  .destination-inclusion ul { display: grid; gap: 17px; margin: 0; padding: 0; list-style: none; }
  .destination-inclusion li { display: flex; align-items: start; gap: 12px; font-size: var(--text-sm); line-height: 1.6; }
  .destination-inclusion li svg { flex-shrink: 0; width: 17px; height: 17px; margin-top: 2px; color: #7c9174; }
  .destination-callout { display: flex; align-items: center; justify-content: space-between; gap: 30px; margin-top: 25px; padding: 30px; background: #e9ece3; }
  .destination-callout p { max-width: 340px; margin: 0; font-size: var(--text-sm); color: #60705b; }

  /* Gallery */
  .destination-gallery__filters { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; margin-bottom: 25px; }
  .destination-chip { padding: 10px 16px; border: 1px solid #cad1c6; background: none; color: inherit; font-size: var(--text-label); cursor: pointer; transition: background .2s, color .2s; }
  .destination-chip[aria-pressed='true'], .destination-chip:hover { background: #102c2d; border-color: #102c2d; color: #fff; }
  .destination-gallery__count { margin-left: auto; font-size: var(--text-label); color: #6b7b63; }
  .destination-gallery__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-auto-flow: dense; gap: 12px; }
  .destination-gallery__photo { position: relative; aspect-ratio: 4 / 3; overflow: hidden; padding: 0; border: 0; background: #c3cebd; cursor: zoom-in; }
  .destination-gallery__photo[hidden] { display: none; }
  .destination-gallery__photo--featured { grid-column: span 2; grid-row: span 2; aspect-ratio: auto; }
  .destination-gallery__photo img { width: 100%; height: 100%; object-fit: cover; transition: transform .6s; }
  .destination-gallery__photo:hover img { transform: scale(1.035); }
  .destination-gallery__label { position: absolute; inset: auto 0 0; display: flex; justify-content: space-between; align-items: center; gap: 15px; padding: 30px 16px 13px; background: linear-gradient(transparent, #061d1dab); color: #fff; font-size: var(--text-label); letter-spacing: .09em; text-transform: uppercase; text-align: left; }
  .destination-gallery__label svg { width: 15px; height: 15px; }
  .destination-lightbox { margin: auto; width: min(1200px, calc(100% - 30px)); max-width: none; max-height: 95svh; padding: 50px 25px 20px; border: 0; background: #102727; color: #fff; }
  .destination-lightbox::backdrop { background: #041a1ab3; backdrop-filter: blur(4px); }
  .destination-lightbox__close { position: absolute; top: 12px; right: 12px; display: inline-flex; padding: 8px; border: 0; background: none; color: inherit; cursor: pointer; }
  .destination-lightbox__close svg { width: 22px; height: 22px; }
  .destination-lightbox__image { display: block; width: 100%; height: min(70svh, 750px); object-fit: contain; }
  .destination-lightbox__bottom { display: flex; justify-content: space-between; align-items: center; gap: 25px; padding-top: 17px; }
  .destination-lightbox__bottom p { margin: 0; font-size: var(--text-sm); color: #c1cdbb; }
  .destination-lightbox__controls { display: flex; align-items: center; gap: 16px; white-space: nowrap; font-size: var(--text-label); }
  .destination-lightbox__controls button { display: grid; place-items: center; width: 42px; height: 42px; border: 1px solid #ffffff40; background: none; color: inherit; cursor: pointer; }
  .destination-lightbox__controls svg { width: 16px; height: 16px; }

  /* FAQ */
  .destination-faq { border-top: 1px solid #d6dad2; }
  .destination-faq details { border-bottom: 1px solid #d6dad2; }
  .destination-faq summary { display: flex; justify-content: space-between; align-items: center; gap: 20px; padding: 23px 0; font-size: var(--text-sm); font-weight: 600; list-style: none; cursor: pointer; }
  .destination-faq summary::-webkit-details-marker { display: none; }
  .destination-faq summary svg { flex-shrink: 0; width: 16px; height: 16px; transition: transform .3s; }
  .destination-faq details[open] summary svg { transform: rotate(45deg); }
  .destination-faq .destination-body { max-width: 780px; padding-bottom: 12px; }

  /* Final CTA */
  .destination-final { padding-block: 70px; background: #102c2d; color: #fff; }
  .destination-final__inner { display: flex; justify-content: space-between; align-items: center; gap: 40px; }
  .destination-final .destination-h2 { margin-bottom: 22px; }
  .destination-final p { margin: 0; font-size: var(--text-sm); color: #bac8b5; }
  .destination-final__actions { display: flex; flex-direction: column; gap: 15px; min-width: 290px; }
  .destination-final__actions .destination-btn { justify-content: space-between; }

  /* Booking bar */
  .destination-booking { position: fixed; left: 0; right: 0; bottom: 0; z-index: 35; border-top: 1px solid #d6dad2; background: #f6f5f0; color: #102c2d; }
  .destination-booking__inner { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding-block: 16px; }
  .destination-booking h3 { margin: 0; font-size: 26px; line-height: 1; text-transform: uppercase; }
  .destination-booking span { display: block; margin-top: 5px; font-size: var(--text-label); color: #667c6a; }
  .destination-booking__actions { display: flex; align-items: center; gap: 25px; }
  body:has(.destination-booking) { padding-bottom: 90px; }

  @media (max-width: 1100px) {
    .destination-section { padding-block: 75px; }
    .destination-editorial { gap: 45px; }
    .destination-cards--techniques { gap: 25px; }
    .destination-equipment { padding: 24px; }
    .destination-callout { flex-wrap: wrap; }
    .destination-callout p { flex-basis: 100%; max-width: 100%; }
    .destination-option { padding: 30px; }
  }
  @media (max-width: 760px) {
    .destination-section { padding-block: 60px; }
    .destination-top { flex-wrap: wrap; align-items: start; gap: 20px; margin-bottom: 30px; }
    .destination-top__intro { max-width: 100%; }
    .destination-h2 { font-size: 51px; }
    .destination-hero { height: 720px; }
    .destination-hero__image img { object-position: 78% center; }
    .destination-hero h1 { font-size: 83px; }
    .destination-hero__content { padding-bottom: 38px; }
    .destination-hero__actions { gap: 18px; }
    .destination-hero__actions .destination-btn { padding: 17px 20px; gap: 20px; }
    .destination-recap { grid-template-columns: 1fr 1fr; gap: 25px; padding-block: 28px; }
    .destination-recap > div { gap: 10px; }
    .destination-recap svg { width: 21px; height: 21px; }
    .destination-nav__inner { gap: 23px; padding-block: 20px; }
    .destination-editorial, .destination-cards, .destination-cards--2 { grid-template-columns: 1fr; gap: 28px; }
    .destination-editorial--reverse .destination-editorial__photo { order: 0; }
    .destination-editorial__photo img { height: 400px; }
    .destination-strip { flex-direction: column; align-items: start; gap: 10px; }
    .destination-season, .destination-option, .destination-equipment, .destination-inclusion { padding: 28px; }
    .destination-season .destination-card-h3 { font-size: 40px; }
    .destination-option .destination-card-h3 { font-size: 42px; }
    .destination-callout { padding: 25px; gap: 20px; }
    .destination-callout .destination-btn { width: 100%; justify-content: space-between; }
    .destination-gallery__count { flex-basis: 100%; margin: 5px 0 0; }
    .destination-gallery__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
    .destination-gallery__photo--featured { grid-column: span 2; grid-row: span 1; aspect-ratio: 16 / 10; }
    .destination-gallery__label { padding: 25px 10px 10px; }
    .destination-lightbox { padding: 45px 15px 15px; }
    .destination-lightbox__image { height: 62svh; }
    .destination-lightbox__bottom { flex-direction: column; gap: 12px; text-align: center; }
    .destination-final { padding-block: 55px; }
    .destination-final__inner { flex-direction: column; align-items: stretch; gap: 30px; }
    .destination-final .destination-h2 { font-size: 56px; }
    .destination-final__actions { min-width: 0; }
    .destination-booking__inner { gap: 10px; padding-block: 12px; }
    .destination-booking h3 { font-size: 24px; }
    .destination-booking__actions { gap: 10px; }
    .destination-booking .destination-btn { padding: 16px; gap: 10px; }
    .destination-booking .destination-btn--text { border: 0; }
    .destination-booking .destination-btn--text svg { display: none; }
    body:has(.destination-booking) { padding-bottom: 80px; }
  }
{% endstylesheet %}
