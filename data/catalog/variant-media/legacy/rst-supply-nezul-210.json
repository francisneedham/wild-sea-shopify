":"disabled"},"ampEnabled":false,"isRestrictiveCookiePolicyEnabled":false,"seoHidden":false,"userAccountsSettings":{"loginAllowed":true,"signupAllowed":true},"cookieBannerText":"By using this website, you agree to our use of cookies. We use cookies to provide you with a great experience and to help our website run effectively.","isCookieBannerEnabled":true,"isVisitorDataRestricted":false,"contactEmail":"fishing@wildseaexpedition.com","contactPhoneNumber":""},"item":{"id":"6a12c250086f311fc02bbcb0","collectionId":"64ece4408179522705abe954","recordType":11,"addedOn":1779614288463,"updatedOn":1788216647882,"displayIndex":62,"starred":false,"passthrough":false,"tags":["saltwater lures","fishing lures","offshore fishing","inshore fishing","spinning fishing","predator fishing","offshore lure"],"categoryIds":["679a43dd9ae1111daafd7fb7"],"workflowState":1,"publishOn":1779614547446,"authorId":"5ffc5761c053a66d48c24272","systemDataId":"51faad15-fd03-4b9d-9831-5f3f8a463f16","systemDataVariants":"1920x2560","systemDataSourceType":"JPEG","filename":"IMG_20260513_225659_61599587014469.jpg","mediaFocalPoint":{"x":0.5,"y":0.5,"source":3},"colorData":{"topLeftAverage":"000000","topRightAverage":"000000","bottomLeftAverage":"000000","bottomRightAverage":"000000","centerAverage":"ce4051","suggestedBgColor":"050202"},"urlId":"rst-supply-nezul-210","title":"RST Supply Nezul 210","body":"","excerpt":"<p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\"><span>RST Supply Nezul 210 is a highly sought after handmade Japanese wooden lure used to target a large range of pelagic fish.&nbsp;<br /></span><br /><span>The Nezul 210mm delivers performance through enhanced buoyancy that produces unconventional diving behaviour. Occasionally, the lure may mis-dive during retrieval\u2014this is intentional design, not a flaw. Rather than stopping your technique, persist with steady working action. This lure transcends traditional pencil popper classification, offering increased strikes from cautious fish.<br /></span><br /><span>Baitfish such as flying fish will jump out and escape while splashing on surface fleeing from predators, the Nezul has been designed to mimic this unexpected action.</span><br /><span>RST believe walking the dog action and skipping is not a mistake. There are many actions you can use with Nezul such as sliding, skipping and walking the dog etc. The Nezul is a lure that is versatile and surprising that will wake fish up in the most pickiest situations&nbsp;</span></p><ul data-rte-list=\"default\"><li><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\"><span>Length </span>210 mm</p></li><li><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">Gr.82</p></li><li><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">Color Pink</p></li></ul>","likeCount":0,"commentCount":0,"publicCommentCount":0,"commentState":1,"unsaved":false,"fullUrl":"/shop/catalog/p/rst-supply-nezul-210","assetUrl":"https://images.squarespace-cdn.com/content/v1/5ff069cde136752810907ec8/51faad15-fd03-4b9d-9831-5f3f8a463f16/IMG_20260513_225659_61599587014469.jpg","contentType":"image/jpeg","structuredContent":{"_type":"StoreItem","priceCents":0,"salePriceCents":0,"priceMoney":{"currency":"EUR","value":"0.00"},"salePriceMoney":{"currency":"EUR","value":"0.00"},"onSale":false,"productType":1,"customAddButtonText":"Add To Cart","useCustomAddButtonText":false,"variants":[{"attributes":{},"optionValues":[],"id":"02cee16d-3049-45e3-96e6-082f9af02371","sku":"SQ5754232","price":10000,"salePrice":0,"priceMoney":{"currency":"EUR","value":"100.00"},"salePriceMoney":{"currency":"EUR","value":"0.00"},"onSale":false,"unlimited":false,"qtyInStock":3,"width":0.0,"height":0.0,"weight":0.14,"imageIds":[],"images":[],"len":0.0}],"variantOptionOrdering":[],"isSubscribable":false,"fulfilledExternally":false,"productAddOnsConfiguration":{"productAddOns":[]},"mightHavePaymentPlan":false},"priceCents":0,"salePriceCents":0,"priceMoney":{"cu