item":"sqs-uiextensions-product-collection-item","scripts-enabled":false},"pagination":{"prevItem":{"id":"6a12c0fa3fda827df9cc1f36","collectionId":"64ece4408179522705abe954","recordType":11,"addedOn":1779613946533,"updatedOn":1788216646944,"displayIndex":61,"starred":false,"passthrough":false,"tags":["atlantis lure","fishing lures","offshore fishing","inshore fishing","spinning fishing","predator fishing","offshore lure","saltwater lures"],"categoryIds":["679a43dd9ae1111daafd7fb7"],"workflowState":1,"publishOn":1779614199133,"authorId":"5ffc5761c053a66d48c24272","systemDataId":"2d62ddaf-f7e0-4e34-834a-b8a1e8fde3fb","systemDataVariants":"1920x2560","systemDataSourceType":"JPEG","filename":"Atlantis flapper 170 candy.jpg","mediaFocalPoint":{"x":0.5,"y":0.5,"source":3},"colorData":{"topLeftAverage":"000000","topRightAverage":"000000","bottomLeftAverage":"000000","bottomRightAverage":"000000","centerAverage":"7f745c","suggestedBgColor":"010101"},"urlId":"atlantis-flapper-170f","title":"Atlantis Flapper 170F","body":null,"excerpt":"<p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\"><span>The Atlantis&nbsp;Flapper is a diving pencil with a rolling action accompanied by vibration. The unique weight balance enables long diving and a sliding action during the sweep.&nbsp;It is advised by Atlantis not to&nbsp;use a rolling swivel to attach the lure to the leader and a solid ring is the best option to produce the original action.&nbsp;</span></p><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">The ideal action for the Atlantis flapper is a long sweep with a pause, but even a straight wind and twitch will still swim the lure well. By continuously winding the lure, this will maintain a steady rolling action without risking the lure to fly out of the water. At the end of the action the lure will slide from side to side which has been designed on purpose to enhance the last kick of the lure during the action which can be achieved by maintain pressure in the line.&nbsp;</p><p style=\"text-align: start; ; white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">A reaction bite can be induced even in a fast-tempo continuous action with short jerks.&nbsp;</p><ul data-rte-list=\"default\"><li><p style=\"text-align: start; ; white-space:pre-wrap;\" data-rte-preserve-empty=\"true\"><span>Length </span>170 mm</p></li><li><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">Gr.60</p></li></ul>","likeCount":0,"commentCount":0,"publicCommentCount":0,"commentState":1,"unsaved":false,"fullUrl":"/shop/catalog/p/atlantis-flapper-170f","assetUrl":"https://images.squarespace-cdn.com/content/v1/5ff069cde136752810907ec8/2d62ddaf-f7e0-4e34-834a-b8a1e8fde3fb/Atlantis+flapper+170+candy.jpg","contentType":"image/jpeg","structuredContent":{"_type":"StoreItem","priceCents":0,"salePriceCents":0,"priceMoney":{"currency":"EUR","value":"0.00"},"salePriceMoney":{"currency":"EUR","value":"0.00"},"onSale":false,"productType":1,"customAddButtonText":"Add To Cart","useCustomAddButtonText":false,"variants":[{"attributes":{"Color":"GlitterPink"},"optionValues":[{"optionName":"Color","value":"GlitterPink"}],"id":"a6bb1e29-5333-4d3c-9162-4bb2b85eba87","sku":"SQ6919783","price":6000,"salePrice":0,"priceMoney":{"currency":"EUR","value":"60.00"},"salePriceMoney":{"currency":"EUR","value":"0.00"},"onSale":false,"unlimited":false,"qtyInStock":2,"width":0.0,"height":0.0,"weight":0.12,"imageIds":[],"mainImageId":"6a12c1f69bbeeb1bb61806e8","images":[],"mainImage":{"id":"6a12c1f69bbeeb1bb61806e8","assetUrl":"https://images.squarespace-cdn.com/content/v1/5ff069cde136752810907ec8/32e57616-498a-4ff3-93c5-ffc2012d0529/Atlantis+Flapper+170+F+silver+pink.jpg","systemDataSourceType":"JPEG","systemDataVariants":"1920x2560","originalSize":"1920x2560","mediaFocalPoint":{"x":0.5,"y":0.5,"source":3},"title":"Atlantis Flapper 170 F silver pink.jpg","displayIndex":0},"len":0.0},{"attributes":{"Color":"GlitterBlue"},"optionValues":[{"optionName":"Color