{% doc %}
  Page hero (legacy .page-hero): full-bleed photo (parallax) or crossfading slideshow with a slow zoom (Slide blocks), bottom gradient, eyebrow, large title, intro.
  @example
  Add at the top of a page template (e.g. About) in the Theme Editor.
{% enddoc %}
{% render 'destination-styles' %}

<section class="page-hero">
  <div class="page-hero__image"{% if section.blocks.size == 0 %} data-parallax{% endif %}>
    {% if section.blocks.size > 0 %}
      {%- comment -%} Slideshow: crossfade + autoplay in ts/utils/slideshow.ts; the first slide is visible without JS. {%- endcomment -%}
      <div class="page-hero__slides" data-slideshow data-interval="{{ section.settings.interval | times: 1000 }}" style="--zoom-duration: {{ section.settings.interval | plus: 2 }}s">
        {% for block in section.blocks %}
          <div class="page-hero__slide{% if forloop.first %} is-active{% endif %}" data-slide {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}
              {%- if forloop.first -%}
                {{ block.settings.image | image_url: width: 2400 | image_tag: widths: '750, 1100, 1500, 1920, 2400', sizes: '100vw', alt: block.settings.alt | default: block.settings.image.alt, loading: 'eager', fetchpriority: 'high' }}
              {%- else -%}
                {{ block.settings.image | image_url: width: 2400 | image_tag: widths: '750, 1100, 1500, 1920, 2400', sizes: '100vw', alt: block.settings.alt | default: block.settings.image.alt, loading: 'lazy' }}
              {%- endif -%}
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% elsif section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 2200 | image_tag: widths: '750, 1100, 1500, 2200', sizes: '100vw', alt: section.settings.image_alt | default: section.settings.image.alt, loading: 'eager', fetchpriority: 'high' }}
    {% else %}
      {% render 'home-image', original: section.settings.original, alt: section.settings.image_alt, priority: true, sizes: '100vw' %}
    {% endif %}
  </div>
  <div class="destination-wrap page-hero__content">
    {% if section.settings.kicker != blank %}<p class="destination-eyebrow">{{ section.settings.kicker | escape }}</p>{% endif %}
    <h1 data-reveal="title">{{ section.settings.heading | escape | newline_to_br }}</h1>
    {% if section.settings.text != blank %}<p class="page-hero__text">{{ section.settings.text | escape | newline_to_br }}</p>{% endif %}
  </div>
  {% if section.blocks.size > 1 %}
    <div class="page-hero__dots" data-slideshow-dots>
      {% for block in section.blocks %}
        <button type="button" class="{% if forloop.first %}is-active{% endif %}" data-slide-to="{{ forloop.index0 }}" aria-label="Show photo {{ forloop.index }}"></button>
      {% endfor %}
    </div>
  {% endif %}
</section>

{% stylesheet %}
  .page-hero { position: relative; display: flex; align-items: end; height: 620px; overflow: hidden; color: #fff; background: #102c2d; }
  .page-hero__image { position: absolute; inset: 0; }
  .page-hero__image img { width: 100%; height: 100%; object-fit: cover; }
  .page-hero__slides { position: absolute; inset: 0; }
  .page-hero__slide { position: absolute; inset: 0; overflow: hidden; opacity: 0; transition: opacity 1.4s ease; }
  .page-hero__slide.is-active { opacity: 1; }
  /* Slow constant zoom on the active slide; a leaving slide keeps its scale until it has faded out, then resets. */
  .page-hero__slide img { transform: scale(1); transition: transform 0s linear 1.4s; }
  .page-hero__slide.is-zoom img { transform: scale(1.1); transition: transform var(--zoom-duration, 8s) linear; }
  @media (prefers-reduced-motion: reduce) { .page-hero__slide img, .page-hero__slide.is-zoom img { transform: none; transition: none; } }
  .page-hero__dots { position: absolute; right: var(--site-gutter); bottom: 60px; z-index: 3; display: flex; gap: 10px; }
  .page-hero__dots button { width: 34px; height: 2px; padding: 8px 0; border: 0; background: linear-gradient(#ffffff55, #ffffff55) center / 100% 2px no-repeat; cursor: pointer; }
  .page-hero__dots button.is-active { background-image: linear-gradient(#dfc89e, #dfc89e); }
  .page-hero::after { content: ''; position: absolute; inset: 0; background: linear-gradient(0deg, #061d1dc9, transparent 85%); pointer-events: none; }
  .page-hero__content { position: relative; z-index: 2; width: 100%; padding-bottom: 60px; }
  .page-hero h1 { margin: 0 0 17px; font-size: clamp(82px, 10vw, 144px); line-height: .92; letter-spacing: -.02em; text-transform: uppercase; }
  .page-hero__text { max-width: 460px; margin: 0; font-size: var(--text-sm); line-height: 1.8; color: #ffffffdc; }
  @media (max-width: 760px) {
    .page-hero { height: 650px; }
    .page-hero__content { padding-bottom: 45px; }
    .page-hero h1 { font-size: 80px; }
    .page-hero__dots { bottom: 20px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Page hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "select", "id": "original", "label": "Bundled photo (used when no image is picked)", "default": "about-0", "options": [
      { "value": "about-0", "label": "About · guides on expedition" },
      { "value": "hero", "label": "Home hero" },
      { "value": "about-1", "label": "About · expedition 1" }
    ] },
    { "type": "text", "id": "image_alt", "label": "Image description" },
    { "type": "text", "id": "kicker", "label": "Eyebrow" },
    { "type": "textarea", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "text", "label": "Intro" },
    { "type": "range", "id": "interval", "label": "Slideshow interval", "min": 3, "max": 12, "step": 1, "unit": "s", "default": 6 }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "alt", "label": "Image description" }
      ]
    }
  ],
  "presets": [{ "name": "Page hero" }]
}
{% endschema %}
