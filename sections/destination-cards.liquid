{% doc %}
  Destination card grid (legacy techniques / seasons / trip options / equipment / inclusions), picked by "Card style".
  Specs are entered as "Label | Value" lines; buttons link to the destination booking/brochure URL or a custom link.
  @example
  Add this section to a destination template and choose a card style.
{% enddoc %}
{% render 'destination-styles' %}

{%- liquid
  assign style = section.settings.style
  case section.settings.callout_button_target
    when 'booking'
      assign callout_button_link = metaobject.booking_url.value
    when 'brochure'
      assign callout_button_link = metaobject.brochure_url.value
    else
      assign callout_button_link = section.settings.callout_button_link
  endcase
-%}

<div {% if section.settings.anchor != blank %}id="{{ section.settings.anchor | escape }}" {% endif %}class="destination-bg--{{ section.settings.background }}">
  <section class="destination-wrap destination-section">
    {% render 'destination-top', kicker: section.settings.kicker, heading: section.settings.heading, intro: section.settings.intro %}

    <div class="destination-cards destination-cards--{{ style }}{% if section.blocks.size == 2 %} destination-cards--2{% endif %}">
      {% for block in section.blocks %}
        {%- liquid
          assign card = block.settings
          case card.button_target
            when 'booking'
              assign button_link = metaobject.booking_url.value
            when 'brochure'
              assign button_link = metaobject.brochure_url.value
            else
              assign button_link = card.button_link
          endcase
          assign spec_lines = card.specs | newline_to_br | split: '<br />'
        -%}
        {% case style %}
          {% when 'techniques' %}
            <div class="destination-technique" {{ block.shopify_attributes }}>
              {% if card.number != blank %}<span class="destination-technique__number">{{ card.number | escape }}</span>{% endif %}
              <h3 class="destination-card-h3">{{ card.heading | escape }}</h3>
              {% if card.kicker != blank %}<span class="destination-kicker">{{ card.kicker | escape }}</span>{% endif %}
              {% if card.text != blank %}<div class="destination-body">{{ card.text }}</div>{% endif %}
            </div>
          {% when 'seasons' %}
            <article class="destination-season" {{ block.shopify_attributes }}>
              {% if card.kicker != blank %}<p class="destination-eyebrow">{{ card.kicker | escape }}</p>{% endif %}
              <h3 class="destination-card-h3">{{ card.heading | escape }}</h3>
              {% if card.text != blank %}<div class="destination-body">{{ card.text }}</div>{% endif %}
            </article>
          {% when 'options' %}
            <article class="destination-option{% if card.dark %} destination-option--dark{% endif %}" {{ block.shopify_attributes }}>
              {% if card.kicker != blank %}<span class="destination-kicker">{{ card.kicker | escape }}</span>{% endif %}
              <h3 class="destination-card-h3">{{ card.heading | escape }}</h3>
              {% if card.text != blank %}<div class="destination-body">{{ card.text }}</div>{% endif %}
              {% if card.specs != blank %}
                <dl class="destination-option-specs">
                  {% for line in spec_lines %}{% assign pair = line | split: '|' %}{% if pair.size > 1 %}<div><dt>{{ pair[0] | strip | escape }}</dt><dd>{{ pair[1] | strip | escape }}</dd></div>{% endif %}{% endfor %}
                </dl>
              {% endif %}
              {%- if card.dark -%}{%- assign button_style = 'sand' -%}{%- else -%}{%- assign button_style = 'dark' -%}{%- endif -%}
              {% render 'destination-button', label: card.button_label, link: button_link, style: button_style %}
            </article>
          {% when 'equipment' %}
            <article class="destination-equipment" {{ block.shopify_attributes }}>
              {% if card.kicker != blank %}<p class="destination-eyebrow">{{ card.kicker | escape }}</p>{% endif %}
              <h3 class="destination-card-h3">{{ card.heading | escape }}</h3>
              {% if card.specs != blank %}
                <dl>
                  {% for line in spec_lines %}{% assign pair = line | split: '|' %}{% if pair.size > 1 %}<div><dt>{{ pair[0] | strip | escape }}</dt><dd>{{ pair[1] | strip | escape }}</dd></div>{% endif %}{% endfor %}
                </dl>
              {% endif %}
            </article>
          {% when 'inclusions' %}
            <article class="destination-inclusion" {{ block.shopify_attributes }}>
              {% if card.kicker != blank %}<p class="destination-eyebrow">{{ card.kicker | escape }}</p>{% endif %}
              <h3 class="destination-card-h3">{{ card.heading | escape }}</h3>
              {% if card.list != blank %}
                {%- assign items = card.list | newline_to_br | split: '<br />' -%}
                <ul>
                  {% for item in items %}{% assign item_text = item | strip %}{% if item_text != blank %}<li>{% render 'lucide-icon', name: card.list_icon %}{{ item_text | escape }}</li>{% endif %}{% endfor %}
                </ul>
              {% endif %}
            </article>
        {% endcase %}
      {% endfor %}
    </div>

    {% if section.settings.strip_text != blank %}
      <div class="destination-strip">
        {% if section.settings.strip_label != blank %}<span>{{ section.settings.strip_label | escape }}</span>{% endif %}
        <p>{{ section.settings.strip_text | escape }}</p>
      </div>
    {% endif %}

    {% if section.settings.callout_text != blank %}
      <div class="destination-callout">
        <p>{{ section.settings.callout_text | escape }}</p>
        {% render 'destination-button', label: section.settings.callout_link_label, link: section.settings.callout_link, style: 'text' %}
        {% render 'destination-button', label: section.settings.callout_button_label, link: callout_button_link, style: 'dark', icon: 'download' %}
      </div>
    {% endif %}

    {% if section.settings.note != blank %}
      <p class="destination-note{% if section.settings.note_subtle %} destination-note--subtle{% endif %}">
        {% if section.settings.note_icon != 'none' %}{% render 'lucide-icon', name: section.settings.note_icon %}{% endif %}
        <span>{{ section.settings.note | escape }}</span>
      </p>
    {% endif %}
  </section>
</div>

{% schema %}
{
  "name": "Destination cards",
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "Card style",
      "default": "techniques",
      "options": [
        {
          "value": "techniques",
          "label": "Numbered techniques"
        },
        {
          "value": "seasons",
          "label": "Seasons (outlined)"
        },
        {
          "value": "options",
          "label": "Trip options (with specs + button)"
        },
        {
          "value": "equipment",
          "label": "Equipment (spec rows)"
        },
        {
          "value": "inclusions",
          "label": "Inclusions (lists)"
        }
      ]
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor ID"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "Page"
        },
        {
          "value": "sage",
          "label": "Sage"
        },
        {
          "value": "stone",
          "label": "Stone"
        }
      ]
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Eyebrow"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro (right of the heading)"
    },
    {
      "type": "header",
      "content": "Below the cards"
    },
    {
      "type": "text",
      "id": "strip_label",
      "label": "Strip label",
      "info": "E.g. \"Also in these waters\"."
    },
    {
      "type": "text",
      "id": "strip_text",
      "label": "Strip text"
    },
    {
      "type": "header",
      "content": "Callout"
    },
    {
      "type": "textarea",
      "id": "callout_text",
      "label": "Callout text"
    },
    {
      "type": "text",
      "id": "callout_link_label",
      "label": "Callout text link label"
    },
    {
      "type": "url",
      "id": "callout_link",
      "label": "Callout text link"
    },
    {
      "type": "text",
      "id": "callout_button_label",
      "label": "Callout button label"
    },
    {
      "type": "select",
      "id": "callout_button_target",
      "label": "Callout button links to",
      "default": "brochure",
      "options": [
        {
          "value": "booking",
          "label": "Destination booking URL"
        },
        {
          "value": "brochure",
          "label": "Destination brochure URL"
        },
        {
          "value": "custom",
          "label": "Custom link"
        }
      ]
    },
    {
      "type": "url",
      "id": "callout_button_link",
      "label": "Callout button custom link"
    },
    {
      "type": "header",
      "content": "Note"
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "Note"
    },
    {
      "type": "select",
      "id": "note_icon",
      "label": "Note icon",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "wind",
          "label": "Wind"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "note_subtle",
      "label": "Small note",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number (techniques)"
        },
        {
          "type": "text",
          "id": "kicker",
          "label": "Eyebrow / kicker"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "textarea",
          "id": "specs",
          "label": "Specs",
          "info": "One per line: Label | Value"
        },
        {
          "type": "textarea",
          "id": "list",
          "label": "List items",
          "info": "One per line (inclusions)."
        },
        {
          "type": "select",
          "id": "list_icon",
          "label": "List icon",
          "default": "check",
          "options": [
            {
              "value": "check",
              "label": "Check"
            },
            {
              "value": "plus",
              "label": "Plus"
            }
          ]
        },
        {
          "type": "checkbox",
          "id": "dark",
          "label": "Dark card (trip options)",
          "default": false
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        },
        {
          "type": "select",
          "id": "button_target",
          "label": "Button links to",
          "default": "booking",
          "options": [
            {
              "value": "booking",
              "label": "Destination booking URL"
            },
            {
              "value": "brochure",
              "label": "Destination brochure URL"
            },
            {
              "value": "custom",
              "label": "Custom link"
            }
          ]
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button custom link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Destination cards"
    }
  ]
}
{% endschema %}
