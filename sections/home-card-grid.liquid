{% doc %}
  Renders destination, collection, or curated photo cards with merchant ordering.
  Uses section headings, layout, link and scheme; block content and resources.

  @example
  Add Featured destinations, Shop categories, or Expedition gallery in the editor.
{% enddoc %}

{% render 'home-styles' %}

{%- assign is_carousel = false -%}
{%- if section.settings.layout == 'carousel' -%}{%- assign is_carousel = true -%}{%- endif -%}

<section {% if is_carousel %}data-carousel {% endif %}class="home-section color-scheme color-{{ section.settings.color_scheme }}" aria-labelledby="HomeGrid-{{ section.id }}">
  <div class="home-wrap">
    <div class="home-top">
      <div>
        {% if section.settings.kicker != blank %}<p class="home-kicker">{{ section.settings.kicker | escape }}</p>{% endif %}
        <h2 class="home-heading" data-reveal="title" id="HomeGrid-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        {% if section.settings.text != blank %}<p class="home-intro">{{ section.settings.text | escape }}</p>{% endif %}
      </div>
      {% if section.settings.link != blank and section.settings.link_label != blank %}
        <a class="home-link" href="{{ section.settings.link | escape }}">{{ section.settings.link_label | escape }}</a>
      {% endif %}
      {% if is_carousel %}
        <div class="home-carousel__controls">
          <button type="button" data-carousel-prev aria-label="Previous photos">{% render 'lucide-icon', name: 'arrow-left' %}</button>
          <button type="button" data-carousel-next aria-label="Next photos">{% render 'lucide-icon', name: 'arrow-right' %}</button>
        </div>
      {% endif %}
    </div>
    {% if is_carousel %}<div class="home-carousel__viewport" data-carousel-viewport>{% endif %}
    <div class="home-grid home-grid--{{ section.settings.layout }}">
      {% for block in section.blocks %}
        {%- liquid
          assign card_image = block.settings.image
          assign card_title = block.settings.heading
          assign card_link = block.settings.link
          assign card_text = block.settings.text
          assign card_original = block.settings.original
          assign photo_only = false
          assign image_sizes = '(min-width: 990px) 33vw, (min-width: 650px) 33vw, 100vw'
          if section.settings.layout == 'categories'
            assign image_sizes = '(min-width: 990px) 25vw, 50vw'
          elsif section.settings.layout == 'gallery'
            assign image_sizes = '(min-width: 650px) 20vw, 50vw'
          elsif is_carousel
            assign image_sizes = '(min-width: 760px) 50vw, 85vw'
          endif
          if block.type == 'collection' and block.settings.collection != blank
            assign card_collection = block.settings.collection
            assign card_image = card_image | default: card_collection.featured_image
            assign card_title = card_collection.title
            assign card_link = card_collection.url
            assign card_original = 'none'
          elsif block.type == 'photo'
            assign photo_only = true
          endif
        -%}
        <div {{ block.shopify_attributes }}>
          {% render 'home-card', image: card_image, original: card_original, heading: card_title, text: card_text, kicker: block.settings.kicker, link: card_link, link_label: block.settings.link_label, badge: block.settings.badge, photo_only: photo_only, sizes: image_sizes %}
        </div>
      {% endfor %}
    </div>
    {% if is_carousel %}</div>{% endif %}
  </div>
</section>

