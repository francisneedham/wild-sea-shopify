{% doc %}
  Editorial story (legacy .editorial), used on destination templates and pages: eyebrow, multi-line title, rich text, focus points, spec rows, buttons, photo + caption.
  Button blocks link to the destination booking/brochure URL (metaobject) or a custom link.
  @example
  Add this section to a destination template; use Anchor ID for the anchor bar.
{% enddoc %}
{% render 'destination-styles' %}

{%- liquid
  assign points = section.blocks | where: 'type', 'point'
  assign specs = section.blocks | where: 'type', 'spec'
  assign buttons = section.blocks | where: 'type', 'button'
-%}

<div {% if section.settings.anchor != blank %}id="{{ section.settings.anchor | escape }}" {% endif %}class="destination-bg--{{ section.settings.background }}">
  <section class="destination-wrap destination-section{% if section.settings.flush_top %} destination-section--flush-top{% endif %} destination-editorial{% if section.settings.reverse %} destination-editorial--reverse{% endif %}">
    <div>
      {% if section.settings.kicker != blank %}<p class="destination-eyebrow">{{ section.settings.kicker | escape }}</p>{% endif %}
      <h2 class="destination-h2" data-reveal="title">{{ section.settings.heading | escape | newline_to_br }}</h2>
      {% if section.settings.text != blank %}<div class="destination-body">{{ section.settings.text }}</div>{% endif %}
      {% if points.size > 0 %}
        <div class="destination-points">
          {% for block in points %}<span {{ block.shopify_attributes }}>{% render 'lucide-icon', name: block.settings.icon %}{{ block.settings.text | escape }}</span>{% endfor %}
        </div>
      {% endif %}
      {% if specs.size > 0 %}
        <dl class="destination-specs-list">
          {% for block in specs %}<div {{ block.shopify_attributes }}><dt>{{ block.settings.label | escape }}</dt><dd>{{ block.settings.value | escape }}</dd></div>{% endfor %}
        </dl>
      {% endif %}
      {% if buttons.size > 0 %}
        <div class="destination-editorial__actions">
          {% for block in buttons %}
            {%- liquid
              case block.settings.target
                when 'booking'
                  assign button_link = metaobject.booking_url.value
                when 'brochure'
                  assign button_link = metaobject.brochure_url.value
                else
                  assign button_link = block.settings.link
              endcase
            -%}
            {% render 'destination-button', label: block.settings.label, link: button_link, style: block.settings.style, icon: block.settings.icon %}
          {% endfor %}
        </div>
      {% endif %}
    </div>
    <figure class="destination-editorial__photo" data-reveal="image">
      {%- assign photo_sizes = '(min-width: 1440px) 660px, (min-width: 761px) 46vw, calc(100vw - 44px)' -%}
      {% if section.settings.image != blank or section.settings.original contains 'socotra' %}
        {% render 'destination-photo', image: section.settings.image, original: section.settings.original, alt: section.settings.image_alt, sizes: photo_sizes %}
      {% elsif section.settings.original != 'none' %}
        {% render 'home-image', original: section.settings.original, alt: section.settings.image_alt, sizes: photo_sizes %}
      {% endif %}
      {% if section.settings.caption != blank %}<figcaption class="destination-caption">{{ section.settings.caption | escape }}</figcaption>{% endif %}
    </figure>
  </section>
</div>

