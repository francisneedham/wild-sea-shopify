{% doc %}
  Partner list: heading row, then one partner per block (optional logo, name, link).
  @example
  Add to the About template and create one Partner block per brand.
{% enddoc %}
{% render 'destination-styles' %}

<section class="destination-bg--{{ section.settings.background }}">
  <div class="destination-wrap destination-section">
    {% render 'destination-top', kicker: section.settings.kicker, heading: section.settings.heading, intro: section.settings.intro %}
    <ul class="page-partners page-partners--{{ section.settings.tiles }}">
      {% for block in section.blocks %}
        <li {{ block.shopify_attributes }}>
          {% if block.settings.link != blank %}<a href="{{ block.settings.link }}" target="_blank" rel="noopener noreferrer">{% else %}<div>{% endif %}
            {% if block.settings.logo != blank %}
              {{ block.settings.logo | image_url: width: 400 | image_tag: widths: '200, 400', sizes: '200px', alt: block.settings.name, loading: 'lazy', class: 'page-partners__logo' }}
            {% else %}
              <span class="page-partners__name">{{ block.settings.name | escape }}</span>
            {% endif %}
            {% if block.settings.link != blank %}{% render 'lucide-icon', name: 'arrow-up-right' %}{% endif %}
          {% if block.settings.link != blank %}</a>{% else %}</div>{% endif %}
        </li>
      {% endfor %}
    </ul>
  </div>
</section>

{% stylesheet %}
  .page-partners { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px; margin: 0; padding: 0; list-style: none; background: #d6dad2; border: 1px solid #d6dad2; }
  .page-partners li { background: #f6f5f0; }
  .page-partners a, .page-partners li > div { position: relative; display: flex; align-items: center; justify-content: center; min-height: 140px; padding: 30px; color: inherit; text-decoration: none; transition: background .2s; }
  .page-partners a:hover { background: #e9ece3; }
  /* Dark tiles: for white/light logos (the legacy partner logos are white). */
  .page-partners--dark { background: #1d4243; border-color: #1d4243; }
  .page-partners--dark li { background: #102c2d; color: #dfc89e; }
  .page-partners--dark a:hover { background: #163a3b; }
  .page-partners svg { position: absolute; top: 14px; right: 14px; width: 15px; height: 15px; opacity: .5; }
  .page-partners__name { font-family: var(--font-heading-family); font-size: 28px; font-weight: 600; line-height: 1; text-align: center; text-transform: uppercase; }
  .page-partners__logo { max-width: 160px; max-height: 70px; width: auto; height: auto; object-fit: contain; }
  @media (max-width: 760px) { .page-partners { grid-template-columns: 1fr 1fr; } .page-partners a, .page-partners li > div { min-height: 110px; padding: 20px; } .page-partners__name { font-size: 22px; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Partners",
  "settings": [
    { "type": "select", "id": "background", "label": "Background", "default": "stone", "options": [{ "value": "none", "label": "Page" }, { "value": "sage", "label": "Sage" }, { "value": "stone", "label": "Stone" }] },
    { "type": "select", "id": "tiles", "label": "Logo tiles", "default": "dark", "options": [{ "value": "dark", "label": "Dark (for white logos)" }, { "value": "light", "label": "Light" }] },
    { "type": "text", "id": "kicker", "label": "Eyebrow" },
    { "type": "textarea", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "intro", "label": "Intro" }
  ],
  "blocks": [
    {
      "type": "partner",
      "name": "Partner",
      "settings": [
        { "type": "image_picker", "id": "logo", "label": "Logo" },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Partners" }]
}
{% endschema %}
